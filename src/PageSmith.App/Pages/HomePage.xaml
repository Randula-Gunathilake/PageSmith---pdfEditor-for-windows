<Page
    x:Class="PageSmith.App.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:infra="clr-namespace:PageSmith.App.Infrastructure"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Home"
    AllowDrop="True"
    DragOver="OnDragOver"
    Drop="OnDrop">
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,28,36,36">
            <ui:TextBlock FontTypography="TitleLarge" Text="Every tool you need to work with PDFs" />
            <ui:TextBlock
                Margin="0,6,0,0"
                FontTypography="Body"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="Merge, split, compress, convert, edit, sign and protect PDFs on your PC — free, without limits, and offline."
                TextWrapping="Wrap" />

            <!--  Drop strip  -->
            <Border
                x:Name="DropStrip"
                Margin="0,22,0,0"
                Padding="20,16"
                Style="{StaticResource Surface}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon
                        FontSize="28"
                        Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                        Symbol="ArrowUpload24" />
                    <StackPanel
                        Grid.Column="1"
                        Margin="14,0"
                        VerticalAlignment="Center">
                        <TextBlock
                            x:Name="DropTitle"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Text="Drop files anywhere on this page" />
                        <TextBlock
                            x:Name="DropHint"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="PageSmith suggests the tools that can open them."
                            TextWrapping="Wrap" />
                        <WrapPanel x:Name="Suggestions" Margin="0,8,0,0" />
                    </StackPanel>
                    <ui:Button
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Click="OnBrowse"
                        Content="Choose files">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="FolderOpen24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </Grid>
            </Border>

            <!--  Category filter  -->
            <WrapPanel x:Name="Filters" Margin="0,24,0,8" />

            <!--  Tool cards  -->
            <ItemsControl x:Name="Cards">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type infra:ToolDescriptor}">
                        <Button
                            Width="264"
                            Height="152"
                            Margin="0,0,14,14"
                            Padding="0"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Click="OnToolClick"
                            Cursor="Hand"
                            Tag="{Binding Id}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        x:Name="Box"
                                        Padding="18,16"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Border
                                        Width="40"
                                        Height="40"
                                        HorizontalAlignment="Left"
                                        Background="{Binding Accent, Converter={StaticResource HexToBrush}}"
                                        CornerRadius="10">
                                        <ui:SymbolIcon
                                            FontSize="22"
                                            Foreground="White"
                                            Symbol="{Binding Icon}" />
                                    </Border>
                                    <Border
                                        Padding="8,2"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                        CornerRadius="10"
                                        ToolTip="{Binding OnlineNote}"
                                        Visibility="{Binding OnlineNote, Converter={StaticResource NullToVisibility}}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon FontSize="12" Symbol="Globe24" />
                                            <TextBlock
                                                Margin="4,0,0,0"
                                                FontSize="11"
                                                Text="Online" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <TextBlock
                                    Grid.Row="1"
                                    Margin="0,12,0,0"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{Binding Title}" />
                                <TextBlock
                                    Grid.Row="2"
                                    Margin="0,4,0,0"
                                    FontSize="12.5"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{Binding Description}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
