<Page
    x:Class="PageSmith.App.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="About">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1100" Margin="36,28,36,36">
            <StackPanel Orientation="Horizontal">
                <Image
                    Width="64"
                    Height="64"
                    Source="pack://application:,,,/Assets/PageSmith-256.png" />
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <ui:TextBlock FontTypography="Title" Text="PageSmith" />
                    <TextBlock
                        x:Name="VersionText"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
            <TextBlock
                Margin="0,16,0,0"
                Text="Every iLovePDF tool, free and Premium, as a Windows app. Your files stay on your PC unless you use an online feature."
                TextWrapping="Wrap" />

            <TextBlock Style="{StaticResource OptionHeader}" Text="Free vs Premium on iLovePDF, and PageSmith" />
            <TextBlock Style="{StaticResource OptionHint}" Text="No limits on files, sizes or options." />
            <DataGrid
                x:Name="Catalog"
                Margin="0,8,0,0"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                HeadersVisibility="Column"
                IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="190"
                        Binding="{Binding Tool}"
                        Header="Tool" />
                    <DataGridTextColumn
                        Width="150"
                        Binding="{Binding Category}"
                        Header="Category" />
                    <DataGridTextColumn
                        Width="240"
                        Binding="{Binding ILovePdf}"
                        Header="On iLovePDF" />
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding PageSmith}"
                        Header="In PageSmith" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Style="{StaticResource OptionHeader}" Text="Built with" />
            <TextBlock Style="{StaticResource OptionHint}" Text="WPF-UI (MIT) · PDFsharp &amp; MigraDoc 6.2.4 (MIT) · PdfPig (Apache 2.0) · Open XML SDK (MIT) · ClosedXML (MIT) · CommunityToolkit.Mvvm (MIT) · Microsoft Edge WebView2 · Anthropic C# SDK (MIT) · Windows.Data.Pdf and Windows.Media.Ocr (built into Windows)." />
            <TextBlock Style="{StaticResource OptionHint}" Text="PageSmith is an independent app and is not affiliated with iLovePDF." />
        </StackPanel>
    </ScrollViewer>
</Page>
