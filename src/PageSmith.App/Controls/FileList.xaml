<UserControl
    x:Class="PageSmith.App.Controls.FileList"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tools="clr-namespace:PageSmith.App.Tools"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DataContext="{d:DesignInstance Type=tools:ToolController}"
    AllowDrop="True"
    DragOver="OnDragOver"
    Drop="OnDrop"
    mc:Ignorable="d">
    <Grid>
        <!--  Empty state: drop zone  -->
        <Grid Margin="20" Visibility="{Binding HasFiles, Converter={StaticResource BoolToVisibilityInverted}}">
            <Rectangle
                RadiusX="12"
                RadiusY="12"
                Stroke="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                StrokeDashArray="6 4"
                StrokeThickness="1.5" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border
                    Width="76"
                    Height="76"
                    HorizontalAlignment="Center"
                    Background="{Binding Descriptor.Accent, Converter={StaticResource HexToBrush}}"
                    CornerRadius="18">
                    <ui:SymbolIcon
                        FontSize="40"
                        Foreground="White"
                        Symbol="{Binding Descriptor.Icon}" />
                </Border>
                <ui:Button
                    MinWidth="220"
                    Height="48"
                    Margin="0,24,0,0"
                    HorizontalAlignment="Center"
                    Appearance="Primary"
                    Click="OnBrowse"
                    FontSize="16"
                    FontWeight="SemiBold">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="FolderOpen24" />
                    </ui:Button.Icon>
                    <TextBlock x:Name="BrowseText" Text="Select files" />
                </ui:Button>
                <TextBlock
                    Margin="0,12,0,0"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="or drop files here" />
                <TextBlock
                    x:Name="FormatsText"
                    Margin="0,4,0,0"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </Grid>

        <!--  File cards  -->
        <Grid Visibility="{Binding HasFiles, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="16,12,16,4">
                <TextBlock
                    x:Name="CountText"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <ui:Button
                        x:Name="AddButton"
                        Margin="0,0,6,0"
                        Click="OnBrowse"
                        Content="Add files">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Add24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button
                        x:Name="SortAscButton"
                        Margin="0,0,6,0"
                        Click="OnSortAscending"
                        ToolTip="Sort A to Z">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ArrowSortDownLines24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button
                        x:Name="SortDescButton"
                        Margin="0,0,6,0"
                        Click="OnSortDescending"
                        ToolTip="Sort Z to A">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ArrowSortUp24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button Click="OnClear" ToolTip="Remove all files">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Delete24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
            </Grid>
            <ListBox
                x:Name="List"
                Grid.Row="1"
                Padding="8"
                Background="Transparent"
                BorderThickness="0"
                ItemsSource="{Binding Files}"
                PreviewMouseLeftButtonDown="OnItemMouseDown"
                PreviewMouseMove="OnItemMouseMove"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="6" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="AllowDrop" Value="True" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <EventSetter Event="Drop" Handler="OnItemDrop" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type tools:FileEntry}">
                        <Border
                            x:Name="Card"
                            Width="164"
                            Padding="10"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            ToolTip="{Binding Path}">
                            <StackPanel>
                                <Grid Height="170">
                                    <Border
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="White"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                        <Image
                                            MaxWidth="140"
                                            MaxHeight="166"
                                            RenderOptions.BitmapScalingMode="HighQuality"
                                            Source="{Binding Thumbnail}">
                                            <Image.LayoutTransform>
                                                <RotateTransform Angle="{Binding Rotation}" />
                                            </Image.LayoutTransform>
                                        </Image>
                                    </Border>
                                    <ui:SymbolIcon
                                        FontSize="48"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Symbol="DocumentPdf24"
                                        Visibility="{Binding Thumbnail, Converter={StaticResource NullToVisibilityInverted}}" />
                                    <ui:Button
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Appearance="Caution"
                                        Click="OnUnlock"
                                        Content="Unlock"
                                        Visibility="{Binding NeedsPassword, Converter={StaticResource BoolToVisibility}}">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="LockClosed24" />
                                        </ui:Button.Icon>
                                    </ui:Button>
                                    <StackPanel
                                        x:Name="Actions"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Orientation="Horizontal"
                                        Visibility="Hidden">
                                        <ui:Button
                                            Padding="5"
                                            Click="OnMoveLeft"
                                            ToolTip="Move earlier"
                                            Visibility="{Binding DataContext.CanReorder, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVisibility}}">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="ArrowLeft24" />
                                            </ui:Button.Icon>
                                        </ui:Button>
                                        <ui:Button
                                            Margin="2,0,0,0"
                                            Padding="5"
                                            Click="OnMoveRight"
                                            ToolTip="Move later"
                                            Visibility="{Binding DataContext.CanReorder, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVisibility}}">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="ArrowRight24" />
                                            </ui:Button.Icon>
                                        </ui:Button>
                                        <ui:Button
                                            Margin="2,0,0,0"
                                            Padding="5"
                                            Click="OnRotate"
                                            ToolTip="Rotate"
                                            Visibility="{Binding DataContext.CanRotateFiles, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVisibility}}">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="ArrowRotateClockwise24" />
                                            </ui:Button.Icon>
                                        </ui:Button>
                                        <ui:Button
                                            Margin="2,0,0,0"
                                            Padding="5"
                                            Click="OnRemove"
                                            ToolTip="Remove">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="Dismiss24" />
                                            </ui:Button.Icon>
                                        </ui:Button>
                                    </StackPanel>
                                </Grid>
                                <TextBlock
                                    Margin="0,8,0,0"
                                    FontWeight="SemiBold"
                                    Text="{Binding Name}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{Binding Details}" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                    Text="{Binding Note}"
                                    TextWrapping="Wrap"
                                    Visibility="{Binding Note, Converter={StaticResource NullToVisibility}}" />
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Actions" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
