<UserControl
    x:Class="PageSmith.App.Controls.HtmlWorkspace"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:PageSmith.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tools="clr-namespace:PageSmith.App.Tools"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DataContext="{d:DesignInstance Type=tools:HtmlToPdfController}"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Web address  -->
        <Border
            Padding="16,14"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock
                    Margin="0,0,0,6"
                    FontWeight="SemiBold"
                    Text="Web page address" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox
                        KeyDown="OnAddressKeyDown"
                        PlaceholderText="https://example.com"
                        Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}">
                        <ui:TextBox.Icon>
                            <ui:SymbolIcon Symbol="Globe24" />
                        </ui:TextBox.Icon>
                    </ui:TextBox>
                    <ui:Button
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Command="{Binding ShowPreviewCommand}"
                        Content="Preview">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Eye24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </Grid>
                <TextBlock
                    Margin="0,6,0,0"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="Web pages need the internet. To convert a saved page offline, add its HTML file below instead." />
            </StackPanel>
        </Border>

        <!--  HTML file, or the preview  -->
        <controls:FileList Grid.Row="1" Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibilityInverted}}" />
        <Grid Grid.Row="1" Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="16,10,16,6">
                <TextBlock
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="Preview (top of the page at the chosen screen width)" />
                <ui:Button
                    HorizontalAlignment="Right"
                    Appearance="Transparent"
                    Command="{Binding ClosePreviewCommand}"
                    Content="Close preview" />
            </Grid>
            <ScrollViewer
                Grid.Row="1"
                Padding="16,0,16,16"
                VerticalScrollBarVisibility="Auto">
                <Border
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Image
                        RenderOptions.BitmapScalingMode="HighQuality"
                        Source="{Binding Preview}"
                        Stretch="Uniform"
                        StretchDirection="DownOnly" />
                </Border>
            </ScrollViewer>
        </Grid>
        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Visibility="{Binding IsPreviewing, Converter={StaticResource BoolToVisibility}}">
            <ui:ProgressRing
                Width="22"
                Height="22"
                IsIndeterminate="True" />
            <TextBlock
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                Text="Loading the page…" />
        </StackPanel>
    </Grid>
</UserControl>
