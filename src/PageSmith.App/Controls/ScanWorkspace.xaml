<UserControl
    x:Class="PageSmith.App.Controls.ScanWorkspace"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:PageSmith.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tools="clr-namespace:PageSmith.App.Tools"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DataContext="{d:DesignInstance Type=tools:ScanController}"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border
            Padding="14,14,14,10"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <UniformGrid Columns="3">
                <ui:CardAction Margin="0,0,6,0" Command="{Binding ScanCommand}">
                    <ui:CardAction.Icon>
                        <ui:SymbolIcon FontSize="24" Symbol="Scan24" />
                    </ui:CardAction.Icon>
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="Scanner" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Scan a page"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardAction>
                <ui:CardAction Margin="3,0" Command="{Binding TakePhotosCommand}">
                    <ui:CardAction.Icon>
                        <ui:SymbolIcon FontSize="24" Symbol="Camera24" />
                    </ui:CardAction.Icon>
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="Camera" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Photograph pages"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardAction>
                <ui:CardAction Margin="6,0,0,0" Command="{Binding AddPhotosCommand}">
                    <ui:CardAction.Icon>
                        <ui:SymbolIcon FontSize="24" Symbol="ImageAdd24" />
                    </ui:CardAction.Icon>
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="Photos" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Add pictures"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardAction>
            </UniformGrid>
        </Border>
        <controls:FileList Grid.Row="1" />
    </Grid>
</UserControl>
