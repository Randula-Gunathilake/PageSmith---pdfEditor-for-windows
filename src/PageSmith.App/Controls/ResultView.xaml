<UserControl
    x:Class="PageSmith.App.Controls.ResultView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tools="clr-namespace:PageSmith.App.Tools"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DataContext="{d:DesignInstance Type=tools:ToolController}"
    mc:Ignorable="d">
    <Border Background="{DynamicResource ApplicationBackgroundBrush}" CornerRadius="8">
        <Border Style="{StaticResource Surface}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel
                    MaxWidth="820"
                    Margin="32,28"
                    HorizontalAlignment="Center">
                    <Border
                        Width="72"
                        Height="72"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}"
                        CornerRadius="36">
                        <ui:SymbolIcon
                            FontSize="40"
                            Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                            Symbol="CheckmarkCircle24" />
                    </Border>
                    <ui:TextBlock
                        Margin="0,16,0,0"
                        HorizontalAlignment="Center"
                        FontTypography="Subtitle"
                        Text="All done" />
                    <TextBlock
                        Margin="0,6,0,0"
                        HorizontalAlignment="Center"
                        FontSize="14"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding Result.Summary}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />

                    <ItemsControl Margin="0,16,0,0" ItemsSource="{Binding Result.Warnings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:InfoBar
                                    Title="Note"
                                    Margin="0,0,0,8"
                                    IsClosable="False"
                                    IsOpen="True"
                                    Message="{Binding}"
                                    Severity="Warning" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Result.OutputFiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,0,0,8"
                                    Padding="14,10"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon
                                            VerticalAlignment="Center"
                                            FontSize="24"
                                            Symbol="Document24" />
                                        <StackPanel
                                            Grid.Column="1"
                                            Margin="12,0"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="{Binding Converter={StaticResource FileName}}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding Converter={StaticResource FolderOf}}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <ui:Button
                                                Click="OnOpenFile"
                                                Content="Open"
                                                Tag="{Binding}">
                                                <ui:Button.Icon>
                                                    <ui:SymbolIcon Symbol="Open24" />
                                                </ui:Button.Icon>
                                            </ui:Button>
                                            <ui:Button
                                                Margin="6,0,0,0"
                                                Click="OnShowInFolder"
                                                Tag="{Binding}"
                                                ToolTip="Show in folder">
                                                <ui:Button.Icon>
                                                    <ui:SymbolIcon Symbol="FolderOpen24" />
                                                </ui:Button.Icon>
                                            </ui:Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Margin="0,8,0,0" Visibility="{Binding Result.Text, Converter={StaticResource NullToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,6">
                            <ui:TextBlock FontTypography="BodyStrong" Text="Text" />
                            <ui:Button
                                Padding="8,2"
                                HorizontalAlignment="Right"
                                Appearance="Transparent"
                                Click="OnCopyText"
                                Content="Copy">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Copy24" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </Grid>
                        <TextBox
                            Grid.Row="1"
                            MaxHeight="380"
                            AcceptsReturn="True"
                            FontFamily="Segoe UI"
                            IsReadOnly="True"
                            Text="{Binding Result.Text, Mode=OneWay}"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" />
                    </Grid>

                    <WrapPanel Margin="0,20,0,0" HorizontalAlignment="Center">
                        <ui:Button
                            x:Name="OpenFirstButton"
                            Margin="4"
                            Appearance="Primary"
                            Click="OnOpenFirst"
                            Content="Open result">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Open24" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:DropDownButton
                            x:Name="ContinueButton"
                            Margin="4"
                            Content="Continue with…">
                            <ui:DropDownButton.Icon>
                                <ui:SymbolIcon Symbol="ArrowForward24" />
                            </ui:DropDownButton.Icon>
                            <ui:DropDownButton.Flyout>
                                <ContextMenu x:Name="ContinueMenu" />
                            </ui:DropDownButton.Flyout>
                        </ui:DropDownButton>
                        <ui:Button
                            Margin="4"
                            Command="{Binding BackToOptionsCommand}"
                            Content="Back to options">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="ArrowLeft24" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button
                            Margin="4"
                            Command="{Binding StartOverCommand}"
                            Content="Start over">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="ArrowReset24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Border>
</UserControl>
