<UserControl
    x:Class="PageSmith.App.Controls.ToolShell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:PageSmith.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:infra="clr-namespace:PageSmith.App.Infrastructure"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tools="clr-namespace:PageSmith.App.Tools"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DataContext="{d:DesignInstance Type=tools:ToolController}"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid Grid.Row="0" Margin="28,20,28,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border
                Width="52"
                Height="52"
                VerticalAlignment="Center"
                Background="{Binding Descriptor.Accent, Converter={StaticResource HexToBrush}}"
                CornerRadius="12">
                <ui:SymbolIcon
                    FontSize="28"
                    Foreground="White"
                    Symbol="{Binding Descriptor.Icon}" />
            </Border>
            <StackPanel
                Grid.Column="1"
                Margin="16,0,0,0"
                VerticalAlignment="Center">
                <ui:TextBlock FontTypography="Title" Text="{Binding Descriptor.Title}" />
                <ui:TextBlock
                    Margin="0,2,0,0"
                    FontTypography="Body"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding Descriptor.Description}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel
                Grid.Column="2"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Border
                    Style="{StaticResource Chip}"
                    ToolTip="This tool's screen is still being built. See TODO.md."
                    Visibility="{Binding Descriptor.InProgress, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon FontSize="14" Symbol="Wrench24" />
                        <TextBlock Margin="6,0,0,0" Text="In progress" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Chip}" Visibility="{Binding Descriptor.OnlineNote, Converter={StaticResource NullToVisibilityInverted}}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon FontSize="14" Symbol="WifiOff24" />
                        <TextBlock Margin="6,0,0,0" Text="Works offline" />
                    </StackPanel>
                </Border>
                <Border
                    Style="{StaticResource Chip}"
                    ToolTip="{Binding Descriptor.OnlineNote}"
                    Visibility="{Binding Descriptor.OnlineNote, Converter={StaticResource NullToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon FontSize="14" Symbol="Globe24" />
                        <TextBlock Margin="6,0,0,0" Text="Uses the internet" />
                    </StackPanel>
                </Border>
                <Border
                    Style="{StaticResource Chip}"
                    ToolTip="{Binding Descriptor.PremiumNote}"
                    Visibility="{Binding Descriptor.PremiumNote, Converter={StaticResource NullToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon
                            FontSize="14"
                            Foreground="#D9A400"
                            Symbol="RibbonStar24" />
                        <TextBlock Margin="6,0,0,0" Text="Premium features included" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!--  Messages  -->
        <StackPanel Grid.Row="1" Margin="28,0,28,10">
            <Border Visibility="{Binding IsOffline, Converter={StaticResource BoolToVisibilityInverted}}">
                <ui:InfoBar
                    Title="Can't continue"
                    IsClosable="True"
                    IsOpen="{Binding Error, Converter={StaticResource HasValue}, Mode=OneWay}"
                    Message="{Binding Error}"
                    Severity="Error" />
            </Border>
            <ui:InfoBar
                Title="You're offline"
                IsClosable="False"
                IsOpen="{Binding IsOffline}"
                Message="{Binding Error}"
                Severity="Warning">
                <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                    <ui:Button
                        Appearance="Primary"
                        Command="{Binding RunCommand}"
                        Content="Retry">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ArrowClockwise24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button
                        Margin="8,0,0,0"
                        Command="{Binding OpenNetworkSettingsCommand}"
                        Content="Network settings">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Wifi124" />
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
            </ui:InfoBar>
        </StackPanel>

        <!--  Workspace and options  -->
        <Grid
            x:Name="MainArea"
            Grid.Row="2"
            Margin="28,0,28,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Surface}">
                <ContentControl x:Name="WorkspaceHost" Focusable="False" />
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Surface}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer Padding="20,18,20,8" VerticalScrollBarVisibility="Auto">
                        <ContentPresenter Content="{Binding}" />
                    </ScrollViewer>
                    <Border
                        Grid.Row="1"
                        Padding="20,14,20,18"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0">
                        <StackPanel>
                            <ui:Button
                                Height="44"
                                HorizontalAlignment="Stretch"
                                Appearance="Primary"
                                Command="{Binding RunCommand}"
                                Content="{Binding ActionText}"
                                FontSize="15"
                                FontWeight="SemiBold">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="ArrowRight24" />
                                </ui:Button.Icon>
                            </ui:Button>
                            <StackPanel Margin="0,12,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                                <ProgressBar
                                    Height="4"
                                    Maximum="100"
                                    Value="{Binding Progress}" />
                                <Grid Margin="0,8,0,0">
                                    <TextBlock
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding Status}"
                                        TextTrimming="CharacterEllipsis" />
                                    <ui:Button
                                        Padding="8,2"
                                        HorizontalAlignment="Right"
                                        Appearance="Transparent"
                                        Command="{Binding CancelCommand}"
                                        Content="Cancel" />
                                </Grid>
                            </StackPanel>
                            <TextBlock
                                Margin="0,8,0,0"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{Binding Status}"
                                TextWrapping="Wrap"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityInverted}}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!--  Result  -->
            <controls:ResultView
                Grid.ColumnSpan="3"
                DataContext="{Binding}"
                Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </Grid>
</UserControl>
