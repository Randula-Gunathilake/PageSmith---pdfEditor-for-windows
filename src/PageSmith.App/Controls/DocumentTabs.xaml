<UserControl
    x:Class="PageSmith.App.Controls.DocumentTabs"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:docs="clr-namespace:PageSmith.App.Documents"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DataContext="{d:DesignInstance Type=docs:DocumentWorkspace}"
    AllowDrop="True"
    DragOver="OnDragOver"
    Drop="OnDrop"
    mc:Ignorable="d">
    <UserControl.Resources>
        <!--  One tab: rounded on top, filled when it is the one in front.  -->
        <Style x:Key="TabBox" TargetType="Border">
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Padding" Value="12,0,6,0" />
            <Setter Property="CornerRadius" Value="8,8,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1,1,1,0" />
        </Style>

        <Style x:Key="TabClose" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Box"
                            Background="Transparent"
                            CornerRadius="4">
                            <ui:SymbolIcon FontSize="13" Symbol="Dismiss24" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border
        Padding="8,6,8,0"
        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
        BorderThickness="0,0,0,1">
        <DockPanel LastChildFill="True">
            <StackPanel
                Margin="8,0,0,4"
                VerticalAlignment="Center"
                DockPanel.Dock="Right"
                Orientation="Horizontal">
                <StackPanel
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Visibility="{Binding Opening, Converter={StaticResource NullToVisibility}}">
                    <ui:ProgressRing
                        Width="16"
                        Height="16"
                        IsIndeterminate="True" />
                    <TextBlock
                        MaxWidth="220"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding Opening, StringFormat='Opening {0}…'}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <ui:Button
                    Padding="10,4"
                    Click="OnOpen"
                    Content="Open"
                    ToolTip="Open a PDF, image or Office file (Ctrl+O)">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="FolderOpen24" />
                    </ui:Button.Icon>
                </ui:Button>
            </StackPanel>

            <!--  Home tab  -->
            <Border
                x:Name="HomeTab"
                Cursor="Hand"
                DockPanel.Dock="Left"
                MouseLeftButtonUp="OnHomeClick"
                Style="{StaticResource TabBox}"
                ToolTip="All tools (Ctrl+Tab to switch tabs)">
                <StackPanel Margin="0,0,6,0" Orientation="Horizontal">
                    <ui:SymbolIcon FontSize="16" Symbol="Home24" />
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Text="Home" />
                </StackPanel>
            </Border>

            <!--  Document tabs, then the "+" button  -->
            <ScrollViewer
                x:Name="TabScroller"
                HorizontalScrollBarVisibility="Hidden"
                PreviewMouseWheel="OnTabsWheel"
                ScrollChanged="OnTabsScrolled"
                VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal">
                    <ItemsControl x:Name="Tabs" ItemsSource="{Binding Documents}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type docs:DocumentSession}">
                                <Border
                                    Cursor="Hand"
                                    Loaded="OnTabLoaded"
                                    MouseDown="OnTabMouseDown"
                                    Style="{StaticResource TabBox}"
                                    ToolTip="{Binding TabToolTip}">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem
                                                Click="OnMenuClose"
                                                Header="Close"
                                                InputGestureText="Ctrl+W" />
                                            <MenuItem Click="OnMenuCloseOthers" Header="Close other tabs" />
                                            <MenuItem Click="OnMenuCloseAll" Header="Close all tabs" />
                                            <Separator />
                                            <MenuItem
                                                Click="OnMenuShowInFolder"
                                                Header="Show in folder"
                                                IsEnabled="{Binding FilePath, Converter={StaticResource HasValue}}" />
                                            <MenuItem
                                                Click="OnMenuCopyPath"
                                                Header="Copy file path"
                                                IsEnabled="{Binding FilePath, Converter={StaticResource HasValue}}" />
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon
                                            FontSize="16"
                                            Foreground="#E5484D"
                                            Symbol="DocumentPdf24" />
                                        <TextBlock
                                            MaxWidth="200"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Text="{Binding Title}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="10"
                                            Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                            Text="●"
                                            ToolTip="Unsaved changes"
                                            Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}" />
                                        <Button
                                            Click="OnCloseTab"
                                            Style="{StaticResource TabClose}"
                                            ToolTip="Close (Ctrl+W)" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ui:Button
                        Width="32"
                        Height="30"
                        Margin="4,0,0,3"
                        Padding="0"
                        VerticalAlignment="Center"
                        Appearance="Transparent"
                        Click="OnOpen"
                        ToolTip="Open in a new tab (Ctrl+O)">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Add24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
