<ui:FluentWindow
    x:Class="PageSmith.App.Controls.CameraWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Take photos"
    Width="920"
    Height="720"
    MinWidth="560"
    MinHeight="440"
    ExtendsContentIntoTitleBar="True"
    ShowInTaskbar="False"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="Take photos of your document" ShowMaximize="False" ShowMinimize="False" />

        <Grid Grid.Row="1" Margin="16,4,16,12">
            <Border Background="#101010" CornerRadius="8">
                <Image
                    x:Name="Preview"
                    RenderOptions.BitmapScalingMode="LowQuality"
                    Stretch="Uniform" />
            </Border>
            <Border
                x:Name="Flash"
                Background="White"
                CornerRadius="8"
                IsHitTestVisible="False"
                Opacity="0" />
            <ui:ProgressRing
                x:Name="Starting"
                Width="40"
                Height="40"
                IsIndeterminate="True" />
            <StackPanel
                x:Name="MessagePanel"
                MaxWidth="460"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="Collapsed">
                <ui:SymbolIcon
                    HorizontalAlignment="Center"
                    FontSize="40"
                    Foreground="White"
                    Symbol="CameraOff24" />
                <TextBlock
                    x:Name="MessageText"
                    Margin="0,12,0,12"
                    FontSize="14"
                    Foreground="White"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <ui:Button
                    x:Name="PrivacyButton"
                    HorizontalAlignment="Center"
                    Click="OnOpenPrivacy"
                    Content="Open camera privacy settings"
                    Visibility="Collapsed" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="16,0,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <ComboBox
                    x:Name="Cameras"
                    MinWidth="200"
                    DisplayMemberPath="DisplayName"
                    SelectionChanged="OnCameraChanged"
                    ToolTip="Camera" />
            </StackPanel>
            <ui:Button
                x:Name="CaptureButton"
                Grid.Column="1"
                Height="48"
                MinWidth="180"
                Appearance="Primary"
                Click="OnCapture"
                Content="Take photo"
                FontSize="15"
                IsEnabled="False">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Camera24" />
                </ui:Button.Icon>
            </ui:Button>
            <StackPanel
                Grid.Column="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock
                    x:Name="CountText"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="No photos yet" />
                <ui:Button Click="OnDone" Content="Done" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
