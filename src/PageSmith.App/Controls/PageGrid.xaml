<UserControl
    x:Class="PageSmith.App.Controls.PageGrid"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:PageSmith.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tools="clr-namespace:PageSmith.App.Tools"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DataContext="{d:DesignInstance Type=tools:PageGridController}"
    AllowDrop="True"
    DragOver="OnDragOver"
    Drop="OnDrop"
    mc:Ignorable="d">
    <Grid>
        <!--  No file yet: reuse the file drop zone  -->
        <controls:FileList Visibility="{Binding HasFiles, Converter={StaticResource BoolToVisibilityInverted}}" />

        <Grid Visibility="{Binding HasFiles, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="16,12,16,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock FontWeight="SemiBold" Text="{Binding SelectionSummary}" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding Hint}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <ui:Button
                        x:Name="AddButton"
                        Margin="0,0,6,0"
                        Click="OnAddFiles"
                        ToolTip="Add PDF">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="DocumentAdd24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button
                        Margin="0,0,6,0"
                        Command="{Binding SelectAllCommand}"
                        ToolTip="Select all">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="SelectAllOn24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button
                        Margin="0,0,6,0"
                        Command="{Binding SelectNoneCommand}"
                        ToolTip="Clear selection">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="DismissCircle24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button
                        x:Name="RotateLeftButton"
                        Margin="0,0,6,0"
                        Command="{Binding RotateAllLeftCommand}"
                        ToolTip="Rotate left">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ArrowRotateCounterclockwise24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button
                        x:Name="RotateRightButton"
                        Margin="0,0,6,0"
                        Command="{Binding RotateAllRightCommand}"
                        ToolTip="Rotate right">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ArrowRotateClockwise24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <Slider
                        x:Name="ZoomSlider"
                        Width="110"
                        VerticalAlignment="Center"
                        Maximum="320"
                        Minimum="110"
                        ToolTip="Thumbnail size"
                        Value="170" />
                </StackPanel>
            </Grid>
            <ListBox
                x:Name="List"
                Grid.Row="1"
                Padding="8"
                Background="Transparent"
                BorderThickness="0"
                ItemsSource="{Binding Pages}"
                PreviewMouseLeftButtonDown="OnMouseDown"
                PreviewMouseMove="OnMouseMove"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                SelectionMode="Extended"
                VirtualizingPanel.IsVirtualizing="True">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="6" />
                        <Setter Property="AllowDrop" Value="True" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <EventSetter Event="Drop" Handler="OnItemDrop" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type tools:PageItem}">
                        <Border
                            x:Name="Card"
                            Width="{Binding Value, ElementName=ZoomSlider}"
                            Padding="8"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="2"
                            CornerRadius="8"
                            Loaded="OnCardLoaded"
                            MouseLeftButtonUp="OnCardClick">
                            <StackPanel>
                                <Grid Height="{Binding Width, ElementName=Card, Converter={StaticResource PageHeight}}">
                                    <Border
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="White"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                        <Grid>
                                            <Image RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding Thumbnail}">
                                                <Image.LayoutTransform>
                                                    <RotateTransform Angle="{Binding Rotation}" />
                                                </Image.LayoutTransform>
                                            </Image>
                                            <Rectangle
                                                Width="80"
                                                Height="110"
                                                Fill="White"
                                                Visibility="{Binding IsBlank, Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>
                                    </Border>
                                    <Border
                                        x:Name="Check"
                                        Width="24"
                                        Height="24"
                                        Margin="2"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                                        CornerRadius="12"
                                        Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}">
                                        <ui:SymbolIcon
                                            FontSize="14"
                                            Foreground="White"
                                            Symbol="Checkmark24" />
                                    </Border>
                                    <StackPanel
                                        x:Name="Actions"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Visibility="Hidden">
                                        <ui:Button
                                            Padding="5"
                                            Click="OnRotateRight"
                                            ToolTip="Rotate right"
                                            Visibility="{Binding DataContext.AllowRotate, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVisibility}}">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="ArrowRotateClockwise24" />
                                            </ui:Button.Icon>
                                        </ui:Button>
                                        <ui:Button
                                            Margin="0,2,0,0"
                                            Padding="5"
                                            Click="OnRotateLeft"
                                            ToolTip="Rotate left"
                                            Visibility="{Binding DataContext.AllowRotate, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVisibility}}">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="ArrowRotateCounterclockwise24" />
                                            </ui:Button.Icon>
                                        </ui:Button>
                                        <ui:Button
                                            Margin="0,2,0,0"
                                            Padding="5"
                                            Click="OnDuplicate"
                                            ToolTip="Duplicate page"
                                            Visibility="{Binding DataContext.AllowInsert, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVisibility}}">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="Copy24" />
                                            </ui:Button.Icon>
                                        </ui:Button>
                                        <ui:Button
                                            Margin="0,2,0,0"
                                            Padding="5"
                                            Click="OnInsertBlank"
                                            ToolTip="Insert a blank page after this one"
                                            Visibility="{Binding DataContext.AllowInsert, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVisibility}}">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="DocumentAdd24" />
                                            </ui:Button.Icon>
                                        </ui:Button>
                                        <ui:Button
                                            Margin="0,2,0,0"
                                            Padding="5"
                                            Click="OnDelete"
                                            ToolTip="Delete page"
                                            Visibility="{Binding DataContext.AllowDelete, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVisibility}}">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="Delete24" />
                                            </ui:Button.Icon>
                                        </ui:Button>
                                    </StackPanel>
                                </Grid>
                                <TextBlock
                                    Margin="0,6,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Text="{Binding Label}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Actions" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
