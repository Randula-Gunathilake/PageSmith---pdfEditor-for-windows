<UserControl
    x:Class="PageSmith.App.Controls.CompareView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:PageSmith.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tools="clr-namespace:PageSmith.App.Tools"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DataContext="{d:DesignInstance Type=tools:CompareController}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <!--  A page with its highlights, scaled to the column width.  -->
        <DataTemplate x:Key="PageTemplate" DataType="{x:Type tools:ComparePage}">
            <StackPanel Margin="0,0,0,14">
                <Border Background="White">
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="8"
                            Opacity="0.2"
                            ShadowDepth="1" />
                    </Border.Effect>
                    <Viewbox Stretch="Uniform">
                        <Grid Width="{Binding Size.Width}" Height="{Binding Size.Height}">
                            <Image
                                RenderOptions.BitmapScalingMode="HighQuality"
                                Source="{Binding Image}"
                                Stretch="Fill" />
                            <ItemsControl ItemsSource="{Binding Highlights}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding Bounds.X}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Bounds.Y}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type tools:CompareHighlight}">
                                        <Border
                                            Width="{Binding Bounds.Width}"
                                            Height="{Binding Bounds.Height}"
                                            Background="{Binding Color, Converter={StaticResource HexToBrush}}"
                                            Opacity="0.35" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Viewbox>
                </Border>
                <TextBlock
                    Margin="0,4,0,0"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding Label}" />
            </StackPanel>
        </DataTemplate>

        <Style x:Key="PageList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="ItemTemplate" Value="{StaticResource PageTemplate}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <EventSetter Event="Loaded" Handler="OnPageLoaded" />
                        <EventSetter Event="Unloaded" Handler="OnPageUnloaded" />
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!--  Fewer than two files: the usual drop zone  -->
        <Grid Visibility="{Binding HasPair, Converter={StaticResource BoolToVisibilityInverted}}">
            <controls:FileList />
            <StackPanel
                Margin="0,0,0,18"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Orientation="Horizontal"
                Visibility="{Binding IsComparing, Converter={StaticResource BoolToVisibility}}">
                <ui:ProgressRing
                    Width="18"
                    Height="18"
                    IsIndeterminate="True" />
                <TextBlock
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Text="Comparing…" />
            </StackPanel>
        </Grid>

        <!--  Two files: side by side  -->
        <Grid Visibility="{Binding HasPair, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border
                Padding="14,10"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Original" />
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{Binding OldName}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <ui:Button
                        Grid.Column="1"
                        Margin="10,0"
                        VerticalAlignment="Center"
                        Command="{Binding SwapCommand}"
                        ToolTip="Swap original and new version">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ArrowSwap24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="New version" />
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="{Binding NewName}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <CheckBox
                            x:Name="SyncScroll"
                            Margin="0,0,8,0"
                            Content="Scroll together"
                            IsChecked="True" />
                        <ui:Button
                            Command="{Binding StartOverCommand}"
                            ToolTip="Choose other files">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="DocumentDismiss24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!--  Text changes  -->
            <Grid Grid.Row="1" Visibility="{Binding Overlay, Converter={StaticResource BoolToVisibilityInverted}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ListBox
                    x:Name="OldList"
                    ItemsSource="{Binding OldPages}"
                    Style="{StaticResource PageList}" />
                <Border Grid.Column="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" />
                <ListBox
                    x:Name="NewList"
                    Grid.Column="2"
                    ItemsSource="{Binding NewPages}"
                    Style="{StaticResource PageList}" />
            </Grid>

            <!--  Visual overlay  -->
            <Grid Grid.Row="1" Visibility="{Binding Overlay, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel
                    Margin="16,10,16,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
                    <Border
                        Width="12"
                        Height="12"
                        Background="#DC2828" />
                    <TextBlock
                        Margin="6,0,16,0"
                        FontSize="12"
                        Text="Only in the original" />
                    <Border
                        Width="12"
                        Height="12"
                        Background="#1E5AE6" />
                    <TextBlock
                        Margin="6,0,16,0"
                        FontSize="12"
                        Text="Only in the new version" />
                    <Border
                        Width="12"
                        Height="12"
                        Background="#8A8A8A" />
                    <TextBlock
                        Margin="6,0,0,0"
                        FontSize="12"
                        Text="In both" />
                </StackPanel>
                <ListBox
                    x:Name="OverlayList"
                    Grid.Row="1"
                    MaxWidth="720"
                    ItemsSource="{Binding OverlayPages}"
                    Style="{StaticResource PageList}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
