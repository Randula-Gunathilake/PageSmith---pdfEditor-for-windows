<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:PageSmith.App.Controls"
    xmlns:editor="clr-namespace:PageSmith.App.Tools.Editor"
    xmlns:tools="clr-namespace:PageSmith.App.Tools"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!--  Options panels of the page-editor tools (Crop, Edit, Forms, Sign, Redact) and the property panels of the items they place.  -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/PageSmith;component/Themes/Styles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="NoDocumentHint" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,2,0,6" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="OpacityRow" TargetType="Grid">
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <!--  ============================== Item properties  -->

    <DataTemplate DataType="{x:Type editor:TextItem}">
        <StackPanel>
            <StackPanel Visibility="{Binding IsStyleOnly, Converter={StaticResource BoolToVisibilityInverted}}">
                <TextBlock Style="{StaticResource OptionHeader}" Text="Text" />
                <ui:TextBox
                    MinHeight="64"
                    AcceptsReturn="True"
                    Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Style="{StaticResource OptionHeader}" Text="Font" />
            <ComboBox
                IsEditable="True"
                ItemsSource="{x:Static editor:TextItem.AvailableFonts}"
                Text="{Binding FontName}" />
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:NumberBox
                    ClearButtonEnabled="False"
                    MaxDecimalPlaces="1"
                    Maximum="400"
                    Minimum="3"
                    SmallChange="1"
                    SpinButtonPlacementMode="Hidden"
                    ToolTip="Font size in points"
                    Value="{Binding FontSize}" />
                <WrapPanel Grid.Column="1" Margin="8,0,0,0">
                    <ToggleButton
                        Width="34"
                        Margin="0,0,4,0"
                        Content="B"
                        FontWeight="Bold"
                        IsChecked="{Binding Bold}"
                        ToolTip="Bold" />
                    <ToggleButton
                        Width="34"
                        Margin="0,0,4,0"
                        Content="I"
                        FontStyle="Italic"
                        IsChecked="{Binding Italic}"
                        ToolTip="Italic" />
                    <ToggleButton
                        Width="34"
                        IsChecked="{Binding Underline}"
                        ToolTip="Underline">
                        <TextBlock Text="U" TextDecorations="Underline" />
                    </ToggleButton>
                </WrapPanel>
            </Grid>
            <TextBlock Style="{StaticResource OptionHeader}" Text="Alignment" />
            <WrapPanel>
                <RadioButton
                    Content="Left"
                    GroupName="TextAlign"
                    IsChecked="{Binding Align, Converter={StaticResource EnumEquals}, ConverterParameter=Left}"
                    Style="{StaticResource Segment}" />
                <RadioButton
                    Content="Centre"
                    GroupName="TextAlign"
                    IsChecked="{Binding Align, Converter={StaticResource EnumEquals}, ConverterParameter=Center}"
                    Style="{StaticResource Segment}" />
                <RadioButton
                    Content="Right"
                    GroupName="TextAlign"
                    IsChecked="{Binding Align, Converter={StaticResource EnumEquals}, ConverterParameter=Right}"
                    Style="{StaticResource Segment}" />
            </WrapPanel>
            <TextBlock Style="{StaticResource OptionHeader}" Text="Colour" />
            <controls:ColorPicker Color="{Binding Color}" />
            <CheckBox
                Margin="0,10,0,0"
                Content="Cover what's underneath"
                IsChecked="{Binding HasBackground}"
                ToolTip="Draws a box behind the text so the original content doesn't show through." />
            <TextBlock Style="{StaticResource OptionHeader}" Text="Opacity" />
            <Slider
                LargeChange="0.1"
                Maximum="1"
                Minimum="0.1"
                SmallChange="0.05"
                Value="{Binding Opacity}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type editor:ShapeItem}">
        <StackPanel>
            <TextBlock
                Style="{StaticResource OptionHint}"
                Text="A white box that hides whatever is underneath it. Resize it with its handles."
                Visibility="{Binding IsWhiteout, Converter={StaticResource BoolToVisibility}}" />
            <StackPanel Visibility="{Binding IsWhiteout, Converter={StaticResource BoolToVisibilityInverted}}">
                <TextBlock Style="{StaticResource OptionHeader}" Text="Line colour" />
                <controls:ColorPicker Color="{Binding Stroke}" />
                <TextBlock Style="{StaticResource OptionHeader}" Text="Line width" />
                <Slider
                    Maximum="16"
                    Minimum="0.5"
                    SmallChange="0.5"
                    Value="{Binding StrokeWidth}" />
                <StackPanel Visibility="{Binding IsLine, Converter={StaticResource BoolToVisibilityInverted}}">
                    <CheckBox
                        Margin="0,10,0,0"
                        Content="Fill the shape"
                        IsChecked="{Binding FillEnabled}" />
                    <controls:ColorPicker
                        Margin="0,6,0,0"
                        Color="{Binding FillColor}"
                        Visibility="{Binding HasFill, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <TextBlock Style="{StaticResource OptionHeader}" Text="Opacity" />
                <Slider
                    LargeChange="0.1"
                    Maximum="1"
                    Minimum="0.1"
                    SmallChange="0.05"
                    Value="{Binding Opacity}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type editor:InkItem}">
        <StackPanel>
            <TextBlock Style="{StaticResource OptionHeader}" Text="Pen colour" />
            <controls:ColorPicker Color="{Binding Color}" />
            <TextBlock Style="{StaticResource OptionHeader}" Text="Pen width" />
            <Slider
                Maximum="12"
                Minimum="0.5"
                SmallChange="0.5"
                Value="{Binding Width}" />
            <TextBlock Style="{StaticResource OptionHeader}" Text="Opacity" />
            <Slider
                LargeChange="0.1"
                Maximum="1"
                Minimum="0.1"
                SmallChange="0.05"
                Value="{Binding Opacity}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type editor:ImageItem}">
        <StackPanel>
            <TextBlock Style="{StaticResource OptionHint}" Text="Drag the corner handles to resize; the picture keeps its proportions." />
            <TextBlock Style="{StaticResource OptionHeader}" Text="Opacity" />
            <Slider
                LargeChange="0.1"
                Maximum="1"
                Minimum="0.1"
                SmallChange="0.05"
                Value="{Binding Opacity}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type editor:FieldItem}">
        <StackPanel>
            <!--  Existing field: its value  -->
            <StackPanel Visibility="{Binding IsExisting, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource OptionHint}" Text="{Binding Name, StringFormat='Field name: {0}'}" />
                <TextBlock
                    Style="{StaticResource OptionHint}"
                    Text="This field is read-only."
                    Visibility="{Binding ReadOnly, Converter={StaticResource BoolToVisibility}}" />
                <StackPanel Visibility="{Binding IsFillable, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource OptionHeader}" Text="Value" />
                    <ui:TextBox
                        AcceptsReturn="{Binding Multiline}"
                        Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap"
                        Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}" />
                    <CheckBox
                        Content="Ticked"
                        IsChecked="{Binding Checked}"
                        Visibility="{Binding IsCheck, Converter={StaticResource BoolToVisibility}}" />
                    <ComboBox
                        ItemsSource="{Binding Options}"
                        SelectedItem="{Binding Value}"
                        Visibility="{Binding IsChoice, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </StackPanel>

            <!--  New field: its definition  -->
            <StackPanel Visibility="{Binding IsNew, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource OptionHeader}" Text="Field name" />
                <ui:TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource OptionHint}" Text="Shown to people filling the form and used when the data is exported." />
                <StackPanel Visibility="{Binding HasOptions, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource OptionHeader}" Text="Choices" />
                    <ui:TextBox
                        MinHeight="72"
                        AcceptsReturn="True"
                        Text="{Binding OptionsText, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource OptionHint}" Text="One per line, or separated by commas." />
                </StackPanel>
                <StackPanel Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}">
                    <CheckBox
                        Margin="0,10,0,0"
                        Content="Several lines"
                        IsChecked="{Binding Multiline}" />
                    <TextBlock Style="{StaticResource OptionHeader}" Text="Default text (optional)" />
                    <ui:TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!--  Layer and delete buttons for a selected item.  -->
    <DataTemplate x:Key="SelectionActions">
        <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Style="{StaticResource OptionHeader}" Text="Arrange" />
            <WrapPanel>
                <ui:Button
                    Margin="0,0,6,6"
                    Command="{Binding BringForwardCommand}"
                    Content="Bring to front">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ArrowUp24" />
                    </ui:Button.Icon>
                </ui:Button>
                <ui:Button
                    Margin="0,0,6,6"
                    Command="{Binding SendBackwardCommand}"
                    Content="Send to back">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ArrowDown24" />
                    </ui:Button.Icon>
                </ui:Button>
                <ui:Button
                    Margin="0,0,6,6"
                    Command="{Binding DeleteSelectedCommand}"
                    Content="Delete">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Delete24" />
                    </ui:Button.Icon>
                </ui:Button>
            </WrapPanel>
        </StackPanel>
    </DataTemplate>

    <!--  ============================== Crop  -->

    <DataTemplate DataType="{x:Type tools:CropController}">
        <StackPanel>
            <TextBlock
                Style="{StaticResource NoDocumentHint}"
                Text="Add a PDF, then drag the frame on the page to choose the area to keep."
                Visibility="{Binding HasDocument, Converter={StaticResource BoolToVisibilityInverted}}" />
            <StackPanel Visibility="{Binding HasDocument, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource OptionHint}" Text="Drag the frame or its handles on the page. Everything outside the frame is cut away." />
                <TextBlock Style="{StaticResource OptionHeader}" Text="Crop" />
                <RadioButton IsChecked="{Binding CurrentPageOnly, Converter={StaticResource InverseBool}}" Style="{StaticResource OptionCard}">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="All pages" />
                        <TextBlock Style="{StaticResource OptionHint}" Text="The same area is kept on every page." />
                    </StackPanel>
                </RadioButton>
                <RadioButton IsChecked="{Binding CurrentPageOnly}" Style="{StaticResource OptionCard}">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="This page only" />
                        <TextBlock Style="{StaticResource OptionHint}" Text="Only the page shown is cropped." />
                    </StackPanel>
                </RadioButton>
                <TextBlock Style="{StaticResource OptionHeader}" Text="Area" />
                <TextBlock Style="{StaticResource OptionHint}" Text="{Binding AreaText}" />
                <WrapPanel Margin="0,4,0,0">
                    <ui:Button
                        Margin="0,0,6,6"
                        Command="{Binding AutoDetectCommand}"
                        Content="Fit to content">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Wand24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button
                        Margin="0,0,6,6"
                        Command="{Binding ResetAreaCommand}"
                        Content="Whole page">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ArrowReset24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </WrapPanel>
                <TextBlock Style="{StaticResource OptionHint}" Text="Cropping hides the outside area in every PDF viewer. To remove sensitive content for good, use Redact PDF." />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!--  ============================== Edit PDF  -->

    <DataTemplate DataType="{x:Type tools:EditController}">
        <StackPanel>
            <TextBlock
                Style="{StaticResource NoDocumentHint}"
                Text="Add a PDF, then use the toolbar above the page to add text, images, shapes and drawings, or to change existing text."
                Visibility="{Binding HasDocument, Converter={StaticResource BoolToVisibilityInverted}}" />
            <StackPanel Visibility="{Binding HasDocument, Converter={StaticResource BoolToVisibility}}">
                <TextBlock
                    Style="{StaticResource OptionHint}"
                    Text="Pick a tool above the page. Select an item to change its look here."
                    Visibility="{Binding PropertiesTarget, Converter={StaticResource NullToVisibilityInverted}}" />
                <TextBlock
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="{Binding SelectedItem.Kind}"
                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="Style for new items"
                    Visibility="{Binding PropertiesTarget.IsStyleOnly, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                <ContentControl Content="{Binding PropertiesTarget}" Focusable="False" />
                <ContentControl
                    Content="{Binding}"
                    ContentTemplate="{StaticResource SelectionActions}"
                    Focusable="False" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!--  ============================== Sign PDF  -->

    <Style x:Key="SignaturePreviewBox" TargetType="Border">
        <Setter Property="Width" Value="150" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <DataTemplate DataType="{x:Type tools:SignController}">
        <StackPanel>
            <TextBlock
                Style="{StaticResource NoDocumentHint}"
                Text="Add a PDF, then place your signature, initials, name, date or company stamp on it. You can also sign it with a digital certificate."
                Visibility="{Binding HasDocument, Converter={StaticResource BoolToVisibilityInverted}}" />
            <StackPanel Visibility="{Binding HasDocument, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource OptionHint}" Text="Pick a part in the toolbar above the page, then click where it goes." />

                <TextBlock Style="{StaticResource OptionHeader}" Text="Your name" />
                <ui:TextBox PlaceholderText="Full name" Text="{Binding SignerName, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Style="{StaticResource OptionHeader}" Text="Signature" />
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource SignaturePreviewBox}">
                        <Image
                            Margin="4"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            Source="{Binding SignaturePreview}" />
                    </Border>
                    <ui:Button
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Command="{Binding CreateSignatureCommand}"
                        Content="Draw or type…" />
                </StackPanel>
                <TextBlock Style="{StaticResource OptionHeader}" Text="Initials" />
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource SignaturePreviewBox}">
                        <Image
                            Margin="4"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            Source="{Binding InitialsPreview}" />
                    </Border>
                    <ui:Button
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Command="{Binding CreateInitialsCommand}"
                        Content="Draw or type…" />
                </StackPanel>
                <TextBlock Style="{StaticResource OptionHeader}" Text="Company stamp" />
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource SignaturePreviewBox}">
                        <Image
                            Margin="4"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            Source="{Binding StampPreview}" />
                    </Border>
                    <ui:Button
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Command="{Binding ChooseStampCommand}"
                        Content="Choose image…" />
                </StackPanel>
                <TextBlock Style="{StaticResource OptionHeader}" Text="Date format" />
                <ComboBox ItemsSource="{Binding DateFormats}" SelectedItem="{Binding DateFormat}" />

                <!--  Selected text box  -->
                <StackPanel Visibility="{Binding PropertiesTarget, Converter={StaticResource NullToVisibility}}">
                    <Border
                        Height="1"
                        Margin="0,14,0,4"
                        Background="{DynamicResource CardStrokeColorDefaultBrush}" />
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="{Binding SelectedItem.Kind}" />
                    <ContentControl Content="{Binding PropertiesTarget}" Focusable="False" />
                </StackPanel>
                <ui:Button
                    Margin="0,10,0,0"
                    Command="{Binding DeleteSelectedCommand}"
                    Content="Remove selected"
                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Delete24" />
                    </ui:Button.Icon>
                </ui:Button>

                <!--  Digital signature  -->
                <Border
                    Height="1"
                    Margin="0,16,0,6"
                    Background="{DynamicResource CardStrokeColorDefaultBrush}" />
                <CheckBox Content="Sign with a certificate (digital signature)" IsChecked="{Binding UseDigital}" />
                <TextBlock Style="{StaticResource OptionHint}" Text="Proves who signed and shows if the PDF is changed afterwards. A Premium feature on iLovePDF." />
                <StackPanel Visibility="{Binding UseDigital, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource OptionHeader}" Text="Certificate" />
                    <WrapPanel>
                        <RadioButton
                            Content="From Windows"
                            GroupName="CertSource"
                            IsChecked="{Binding Source, Converter={StaticResource EnumEquals}, ConverterParameter=Windows}"
                            Style="{StaticResource Segment}" />
                        <RadioButton
                            Content="From a file"
                            GroupName="CertSource"
                            IsChecked="{Binding Source, Converter={StaticResource EnumEquals}, ConverterParameter=File}"
                            Style="{StaticResource Segment}" />
                        <RadioButton
                            Content="Create new"
                            GroupName="CertSource"
                            IsChecked="{Binding Source, Converter={StaticResource EnumEquals}, ConverterParameter=New}"
                            Style="{StaticResource Segment}" />
                    </WrapPanel>
                    <StackPanel Visibility="{Binding Source, Converter={StaticResource EnumToVisibility}, ConverterParameter=Windows}">
                        <ComboBox
                            DisplayMemberPath="Text"
                            ItemsSource="{Binding StoreCertificates}"
                            SelectedItem="{Binding SelectedCertificate}" />
                        <TextBlock
                            Style="{StaticResource OptionHint}"
                            Text="No signing certificates were found in your Windows certificate store. Use a .pfx file or create a new certificate."
                            Visibility="{Binding NoStoreCertificates, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding Source, Converter={StaticResource EnumToVisibility}, ConverterParameter=File}">
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Command="{Binding ChoosePfxCommand}" Content="Choose .pfx file…" />
                            <TextBlock
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource OptionHint}"
                                Text="{Binding PfxName}" />
                        </StackPanel>
                        <ui:PasswordBox
                            Margin="0,6,0,0"
                            Password="{Binding PfxPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Certificate password" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding Source, Converter={StaticResource EnumToVisibility}, ConverterParameter=New}">
                        <ui:TextBox PlaceholderText="Name on the certificate" Text="{Binding NewCertName, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:TextBox
                            Margin="0,6,0,0"
                            PlaceholderText="Email (optional)"
                            Text="{Binding NewCertEmail, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:TextBox
                            Margin="0,6,0,0"
                            PlaceholderText="Organisation (optional)"
                            Text="{Binding NewCertOrganization, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox
                            Margin="0,8,0,0"
                            Content="Keep it in my Windows certificate store"
                            IsChecked="{Binding SaveNewCertToWindows}" />
                        <ui:Button
                            Margin="0,8,0,0"
                            Command="{Binding CreateCertificateCommand}"
                            Content="Create certificate">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Certificate24" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <TextBlock Style="{StaticResource OptionHint}" Text="A self-signed certificate. PDF readers show the signature as valid but from an unverified signer until they trust it." />
                    </StackPanel>
                    <TextBlock Style="{StaticResource OptionHeader}" Text="Reason and place (optional)" />
                    <ui:TextBox PlaceholderText="Reason, e.g. I approve this document" Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:TextBox
                        Margin="0,6,0,0"
                        PlaceholderText="Location, e.g. Colombo"
                        Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        Margin="0,10,0,0"
                        Style="{StaticResource OptionHint}"
                        Text="Shown in the box you drew on the page."
                        Visibility="{Binding HasDigitalBox, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock
                        Margin="0,10,0,0"
                        Style="{StaticResource OptionHint}"
                        Text="Invisible signature. To show it on the page, pick the certificate tool above the page and drag a box."
                        Visibility="{Binding HasDigitalBox, Converter={StaticResource BoolToVisibilityInverted}}" />
                    <CheckBox
                        Margin="0,6,0,0"
                        Content="Show my handwritten signature in the box"
                        IsChecked="{Binding ShowHandwritingInBox}" />
                    <CheckBox
                        Margin="0,6,0,0"
                        Content="Add a trusted timestamp (needs the internet)"
                        IsChecked="{Binding AddTimestamp}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!--  ============================== Redact PDF  -->

    <DataTemplate DataType="{x:Type tools:RedactController}">
        <StackPanel>
            <TextBlock
                Style="{StaticResource NoDocumentHint}"
                Text="Add a PDF, then mark the text, pictures or areas to hide. Redacted content is removed from the file for good, not just covered."
                Visibility="{Binding HasDocument, Converter={StaticResource BoolToVisibilityInverted}}" />
            <StackPanel Visibility="{Binding HasDocument, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource OptionHint}" Text="Drag over areas or click words on the page, or let PageSmith find them. Check the list, then press Redact PDF." />

                <TextBlock Style="{StaticResource OptionHeader}" Text="Search" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox PlaceholderText="Word, phrase or pattern" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button
                        Grid.Column="1"
                        Margin="6,0,0,0"
                        Command="{Binding SearchCommand}"
                        Content="Mark"
                        ToolTip="Mark every match in the document">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Search24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </Grid>
                <WrapPanel Margin="0,6,0,0">
                    <CheckBox
                        Margin="0,0,14,0"
                        Content="Match case"
                        IsChecked="{Binding MatchCase}" />
                    <CheckBox
                        Margin="0,0,14,0"
                        Content="Whole words"
                        IsChecked="{Binding WholeWord}" />
                    <CheckBox Content="Regular expression" IsChecked="{Binding UseRegex}" />
                </WrapPanel>

                <TextBlock Style="{StaticResource OptionHeader}" Text="Personal information" />
                <ItemsControl ItemsSource="{Binding Patterns}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type tools:PatternChoice}">
                            <CheckBox
                                Margin="0,0,14,4"
                                Content="{Binding Label}"
                                IsChecked="{Binding Selected}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ui:Button
                    Margin="0,4,0,0"
                    Command="{Binding FindPatternsCommand}"
                    Content="Find and mark">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Wand24" />
                    </ui:Button.Icon>
                </ui:Button>

                <Grid Margin="0,14,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="Marked" />
                        <TextBlock Style="{StaticResource OptionHint}" Text="{Binding MarksSummary}" />
                    </StackPanel>
                    <ui:Button
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Appearance="Transparent"
                        Command="{Binding ClearMarksCommand}"
                        Content="Clear all" />
                </Grid>
                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Marks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type editor:RedactItem}">
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:Button
                                        Padding="8,4"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Appearance="Transparent"
                                        Command="{Binding DataContext.GoToMarkCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Show on the page">
                                        <StackPanel Orientation="Horizontal">
                                            <Border
                                                Width="10"
                                                Height="10"
                                                Margin="0,0,8,0"
                                                Background="Black" />
                                            <TextBlock
                                                MaxWidth="230"
                                                Text="{Binding Description}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Margin="6,0,0,0"
                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                Text="{Binding PageIndex, StringFormat='p. {0}', Converter={StaticResource PageNumber}}" />
                                        </StackPanel>
                                    </ui:Button>
                                    <ui:Button
                                        Grid.Column="1"
                                        Padding="6,4"
                                        Appearance="Transparent"
                                        Command="{Binding DataContext.RemoveMarkCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Don't redact this">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="Dismiss24" />
                                        </ui:Button.Icon>
                                    </ui:Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Style="{StaticResource OptionHeader}" Text="Box colour" />
                <controls:ColorPicker Color="{Binding FillColor}" />
                <TextBlock Style="{StaticResource OptionHeader}" Text="Text in each box (optional)" />
                <ui:TextBox PlaceholderText="e.g. REDACTED" Text="{Binding OverlayText, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox
                    Margin="0,10,0,0"
                    Content="Also remove the title, author and keywords"
                    IsChecked="{Binding RemoveMetadata}" />
                <TextBlock Style="{StaticResource OptionHint}" Text="Pages with marks are rebuilt as images with the boxes burnt in, so hidden text, pictures and drawings are really gone. The rest of the text stays searchable." />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!--  ============================== PDF Forms  -->

    <DataTemplate DataType="{x:Type tools:FormsController}">
        <StackPanel>
            <TextBlock
                Style="{StaticResource NoDocumentHint}"
                Text="Add a PDF to fill in its form, add new fillable fields, or let PageSmith find where fields belong."
                Visibility="{Binding HasDocument, Converter={StaticResource BoolToVisibilityInverted}}" />
            <StackPanel Visibility="{Binding HasDocument, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource OptionHint}" Text="{Binding Summary}" />
                <WrapPanel Margin="0,6,0,0">
                    <ui:Button
                        Margin="0,0,6,6"
                        Command="{Binding DetectFieldsCommand}"
                        Content="Detect fields">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Wand24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button
                        Margin="0,0,6,6"
                        Command="{Binding ClearValuesCommand}"
                        Content="Clear values"
                        Visibility="{Binding HasExistingFields, Converter={StaticResource BoolToVisibility}}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Eraser24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </WrapPanel>
                <TextBlock Style="{StaticResource OptionHint}" Text="Detect fields looks for underlines, empty boxes and tick boxes and adds fields there for you to check." />
                <CheckBox
                    Margin="0,10,0,0"
                    Content="Flatten the form after filling"
                    IsChecked="{Binding Flatten}" />
                <TextBlock Style="{StaticResource OptionHint}" Text="Bakes the answers into the page so they can no longer be changed." />

                <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                    <Border
                        Height="1"
                        Margin="0,12,0,4"
                        Background="{DynamicResource CardStrokeColorDefaultBrush}" />
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="{Binding SelectedItem.Kind}" />
                    <ContentControl Content="{Binding SelectedItem}" Focusable="False" />
                    <ui:Button
                        Margin="0,10,0,0"
                        Command="{Binding DeleteSelectedCommand}"
                        Content="Delete field"
                        Visibility="{Binding SelectedItem.IsNew, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Delete24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
